# Copier ce fichier en .env puis remplir. Ne JAMAIS committer .env.
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------
# SÉCURITÉ — état initial obligatoire (ne pas modifier sans validation)
# ---------------------------------------------------------------
DRY_RUN=true
KILL_SWITCH=true
MANUAL_APPROVAL_REQUIRED=true
AUTO_TRADING=false
# ANALYSIS_ONLY | MANUAL_APPROVAL | AUTO
MODE=MANUAL_APPROVAL
# Exigé uniquement si CAPITAL_ENV=live ET DRY_RUN=false. Laisser vide.
LIVE_TRADING_ACK=
# Exigé EN PLUS si la stratégie n'a pas passé la validation backtest (var/validation_status.json).
LIVE_OVERRIDE_UNVALIDATED=

# ---------------------------------------------------------------
# Capital.com — demo par défaut. Générer la clé : Settings > API integrations.
# Le mot de passe ici est le "custom password" de la clé API.
# ---------------------------------------------------------------
CAPITAL_ENV=demo
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=

# ---------------------------------------------------------------
# Instrument (allowlist stricte)
# ---------------------------------------------------------------
ALLOWED_EPICS=GOLD
INSTRUMENT_SEARCH_TERM=gold
ALLOWED_DIRECTIONS=BUY
ACCOUNT_CURRENCY=CHF
FX_EPIC_QUOTE_TO_ACCOUNT=USDCHF

# ---------------------------------------------------------------
# Risque
# ---------------------------------------------------------------
MAX_RISK_PER_TRADE_CHF=100
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_CHF=150
MAX_DAILY_LOSS_PCT=2.0
MAX_TRADES_PER_DAY=2
MAX_OPEN_POSITIONS=1
MAX_SPREAD_POINTS=0.60
MAX_DATA_AGE_S=180
MAX_QUOTE_AGE_S=30
SL_SLIPPAGE_BUFFER_POINTS=0.10
TRADING_TIMEZONE=Europe/Zurich
MACRO_PAUSE_ENABLED=false
MACRO_PAUSE_MINUTES=30
MACRO_CALENDAR_PATH=var/macro_events.csv

# ---------------------------------------------------------------
# Stratégie (mêmes valeurs en live et en backtest)
# ---------------------------------------------------------------
MIN_SCORE=7
MIN_RR=2.0
TARGET_RR=3.0
# nearest_valid | first_liquidity | prefer_target
TP_MODE=nearest_valid
SL_ATR_MULT=0.25
MAX_TP_ATR_H4=3.0
SETUP_EXPIRY_M15_BARS=16
SESSION_RESET_HOUR_UTC=22

# Poids du score (somme = 10)
W_H4_CONTEXT=2
W_LIQUIDITY_ZONE=1
W_SWEEP=2
W_M15_STRUCTURE=1
W_FVG_OR_OB=1
W_VWAP=1
W_OTE_FIB=1
W_M1_CONFIRMATION=1

# ---------------------------------------------------------------
# Approbation manuelle
# ---------------------------------------------------------------
APPROVAL_TTL_S=180
APPROVAL_MAX_PRICE_DRIFT_POINTS=1.50
APPROVAL_MAX_RISK_INCREASE_PCT=10

# Gestion de position (désactivée — backtester avant activation)
BREAKEVEN_AT_1R=false
PARTIAL_CLOSE_AT_1R=false

# ---------------------------------------------------------------
# Backtest
# ---------------------------------------------------------------
BACKTEST_SLIPPAGE_POINTS=0.10
BACKTEST_COMMISSION_CHF=0
BACKTEST_DEFAULT_SPREAD=0.35
BACKTEST_QUOTE_TO_ACCOUNT_RATE=0.80
BACKTEST_INITIAL_CAPITAL_CHF=1000
VALIDATION_MIN_TRADES=100
VALIDATION_MAX_DRAWDOWN_PCT=20

# ---------------------------------------------------------------
# Alertes / interface
# ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_REPORT_TIME=07:30
WEB_HOST=127.0.0.1
WEB_PORT=8765

DB_PATH=var/trading_bot.sqlite
LOG_PATH=var/trading_bot.log
